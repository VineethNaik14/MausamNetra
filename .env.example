# Copy this file to .env and adjust as needed.
# All values shown are the defaults used if a variable is unset.

# --- Trust score weights (must sum to ~1.0) --------------------------------
TRUST_SOURCE_WEIGHT=0.20
TRUST_LOCATION_WEIGHT=0.20
TRUST_TEMPORAL_WEIGHT=0.15
TRUST_CROSS_SOURCE_WEIGHT=0.20
TRUST_MEDIA_WEIGHT=0.15
TRUST_METADATA_WEIGHT=0.10

# --- Decision thresholds (0-100) -------------------------------------------
VERIFIED_THRESHOLD=80
REVIEW_THRESHOLD=60

# --- Similarity thresholds (0-1) -------------------------------------------
TEXT_SIMILARITY_THRESHOLD=0.85
TEXT_RELATED_THRESHOLD=0.60
IMAGE_SIMILARITY_THRESHOLD=0.90

# --- Media / request limits --------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_REQUEST_BODY_MB=15

# --- Location / temporal tuning ----------------------------------------------
LOCATION_CONSISTENCY_RADIUS_KM=25
CORROBORATION_RADIUS_KM=5
CORROBORATION_WINDOW_HOURS=12
MAX_FUTURE_SKEW_MINUTES=10
STALE_REPORT_HOURS=72

# --- Similarity backend -------------------------------------------------------
# "tfidf" (default, offline-friendly) or "sentence_transformer"
SIMILARITY_BACKEND=tfidf
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Event classifier integration --------------------------------------------
# "local" (default — no classifier wired unless you edit api/dependencies.py)
# or "http" (calls a separate FastAPI classifier service)
CLASSIFIER_MODE=local
CLASSIFIER_HTTP_URL=
CLASSIFIER_HTTP_TIMEOUT_SECONDS=3.0

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
