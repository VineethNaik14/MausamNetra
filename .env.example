# Live weather provider. Open-Meteo needs no key for non-commercial use;
# the client also defaults to this URL if left blank, but setting it
# explicitly avoids an empty string overriding that default.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Official IMD API — optional, requires authorized credentials. Leave
# IMD_API_KEY blank until the team has real access; ingestion/imd/client.py
# raises a clear error instead of running without one.
IMD_API_BASE_URL=https://api.imd.gov.in/public/api
IMD_API_KEY=

# Kafka. Leave empty to use console fallback.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CLEANED=weather.cleaned

# Integration bridge (integration/pipeline_worker.py) + Member 4's classifier wiring
CLASSIFIER_URL=http://localhost:8000
VERIFICATION_URL=http://localhost:8001
CLASSIFIER_MODE=http
CLASSIFIER_HTTP_URL=http://localhost:8000

# Member 4 trust engine tuning (defaults shown; only override if needed)
VERIFIED_THRESHOLD=80.0
REVIEW_THRESHOLD=60.0